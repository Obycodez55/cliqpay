# Copy to .env and fill in real values. Never commit .env.
#
# Only vars something in the app actually reads live here — see
# src/config/config.ts. New vars get added here in the same change that
# wires them up (JWT secrets with auth, KORA_* with the payment adapter,
# etc.), not ahead of time.

# --- App ---
NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/cliqpay

# --- Redis (caching, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Error tracking (no-op until set) ---
SENTRY_DSN=

# --- Rate limiting ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# --- Auth (JWT) ---
# HS256 shared secret for signing access tokens — generate with
# `openssl rand -base64 48` or similar, at least 32 characters.
JWT_SECRET=

# --- Encryption ---
# AES-256-GCM key used to encrypt TOTP secrets at rest — 32 bytes as hex.
# Generate with `openssl rand -hex 32`.
ENCRYPTION_KEY=

# --- Transaction PIN ---
# HMAC-SHA256 pepper applied before bcrypt, so a database dump without this
# value can't be brute-forced against a 4-digit PIN. Generate with
# `openssl rand -hex 32`. Distinct from ENCRYPTION_KEY on purpose — key
# separation limits the blast radius of either one leaking.
#
# This key CANNOT be rotated. Changing it invalidates every PIN in the
# system and forces every user to set a new one; losing it is equivalent to
# wiping them all. Back it up as seriously as the database. See ADR-0009.
TRANSACTION_PIN_PEPPER=

# --- Transfers (P2P) ---
# Flat platform fee in minor units, charged to the sender on top of the
# amount. Launching at 0 as a growth perk. Note: at a non-zero value every
# transfer locks the single fee_income row and they stop running
# concurrently — see docs/architecture.md §4.2.
TRANSFER_PLATFORM_FEE=0
# Bounds per transfer, minor units. The maximum is an interim ceiling until
# Phase 6 KYC tier limits replace it — without it there is no cap on a
# single transfer at all.
TRANSFER_MIN_AMOUNT=10000
TRANSFER_MAX_AMOUNT=100000000

# --- Money requests ---
MONEY_REQUEST_EXPIRY_DAYS=7
# Cap on outstanding pending requests from one requester to one payer — a
# rate limit alone would still let someone aim their whole allowance at a
# single victim.
MONEY_REQUEST_MAX_PENDING_PER_PAIR=3

# --- Notifications retention ---
# In-app notification rows are deleted after this many days regardless of
# read state. Shipped with the channel rather than deferred: a retention
# job's cost is dominated by its first run.
NOTIFICATION_RETENTION_DAYS=180

# --- Notifications ---
# Each channel picks its provider by name; `fake` logs the rendered template
# instead of calling out, so local dev works with zero real credentials.
# Whichever provider is selected has its own vars below required at boot.
EMAIL_PROVIDER=fake   # brevo | fake
SMS_PROVIDER=fake     # termii | fake
PUSH_PROVIDER=fake    # fcm | fake

# Brevo (email) — required when EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Termii (SMS) — required when SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=

# Firebase Cloud Messaging (push) — required when PUSH_PROVIDER=fcm
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payments ---
PAYMENT_PROVIDER=fake   # kora | fake

# Kora (payments) — required when PAYMENT_PROVIDER=kora
KORA_SECRET_KEY=
# This backend's own webhook receiver — sent to Kora as notification_url on
# every charge, e.g. https://api.cliqpay.example.com/wallet/webhook/kora
KORA_WEBHOOK_URL=
# Where Kora's hosted checkout sends the customer back after paying — sent
# as redirect_url. No frontend exists yet (docs/architecture.md §9); set to
# a real frontend URL once one does.
PAYMENT_REDIRECT_URL=

RECONCILIATION_ALERT_EMAIL=ops@cliqpay.test
