{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/\\.pnpm/(?!(otplib|@otplib\\+|@scure\\+|@noble\\+))"
  ],
  "testTimeout": 60000
}
