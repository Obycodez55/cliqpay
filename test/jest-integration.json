{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/\\.pnpm/(?!(otplib|@otplib\\+|@scure\\+|@noble\\+))"
  ],
  "testTimeout": 60000,
  "maxWorkers": 2,
  "setupFiles": [
    "<rootDir>/integration/support/loopback-listen.ts",
    "<rootDir>/integration/support/device-defaults.ts"
  ],
  "globalSetup": "<rootDir>/integration/support/global-setup.ts",
  "globalTeardown": "<rootDir>/integration/support/global-teardown.ts"
}
