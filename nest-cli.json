{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "modules/notifications/templates/email/*.hbs",
      "modules/auth/internal/common-passwords.txt"
    ],
    "watchAssets": true
  }
}
