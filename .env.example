# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/cliqpay

# --- Redis (caching, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Field-level encryption (BVN, bank account numbers) ---
ENCRYPTION_KEY=

# --- Kora (payment provider) ---
KORA_API_KEY=
KORA_WEBHOOK_SECRET=
KORA_BASE_URL=https://api.korapay.com

# --- Kora sandbox (KYC, Phase 6) ---
KORA_KYC_SANDBOX_MODE=true

# --- Email (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Error tracking (deferred until adopted) ---
SENTRY_DSN=
